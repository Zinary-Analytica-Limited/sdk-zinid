{
  "name": "@zinid/sdk-web",
  "version": "0.1.1",
  "description": "Embed ZinID hosted identity verification in your web app — inline, modal, or redirect. Zero dependencies, TypeScript types included.",
  "keywords": [
    "zinid",
    "identity",
    "identity-verification",
    "kyc",
    "verification",
    "onboarding",
    "aml",
    "sdk",
    "iframe",
    "embed",
    "browser"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Zinary-Analytica-Limited/sdk-zinid#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zinary-Analytica-Limited/sdk-zinid.git",
    "directory": "packages/sdk-web"
  },
  "bugs": {
    "url": "https://github.com/Zinary-Analytica-Limited/sdk-zinid/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/zinid.cjs",
  "module": "./dist/zinid.js",
  "types": "./dist/zinid.d.ts",
  "unpkg": "./dist/zinid.min.js",
  "jsdelivr": "./dist/zinid.min.js",
  "exports": {
    ".": {
      "types": "./dist/zinid.d.ts",
      "import": "./dist/zinid.js",
      "require": "./dist/zinid.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && pnpm run size",
    "test:watch": "vitest",
    "size": "pnpm run build && size-limit",
    "test:e2e": "pnpm run build && playwright test",
    "dev": "tsup --watch",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm -w run lint && pnpm run typecheck && pnpm run test"
  },
  "size-limit": [
    {
      "path": "dist/zinid.min.js",
      "limit": "8 KB",
      "gzip": true
    }
  ],
  "publishConfig": {
    "access": "public"
  },
  "//": "Zero runtime dependencies — the SDK uses only browser APIs. Keep `dependencies` empty.",
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@size-limit/file": "^13.0.1",
    "@types/node": "^26.1.2",
    "jsdom": "^30.0.0",
    "size-limit": "^13.0.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
